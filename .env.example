TELEGRAM_BOT_TOKEN="PASTE_TELEGRAM_BOT_TOKEN"

# Gemini model selection (transport: Vertex AI)
GEMINI_MODEL=gemini-2.5-flash

# AI approval QA mode (optional)
AI_APPROVAL_ENABLED=true
AI_APPROVAL_MODEL=gemini-2.5-flash-lite
AI_APPROVAL_STRICTNESS=balanced
AI_APPROVAL_MAX_REGENERATE_ATTEMPTS=2
AI_APPROVAL_IMAGE_THRESHOLD=0.85
AI_APPROVAL_VIDEO_THRESHOLD=0.85
AI_APPROVAL_HUMAN_REVIEW_THRESHOLD=0.70
AI_APPROVAL_EXTRACT_VIDEO_FRAMES=true
AI_APPROVAL_FRAME_COUNT=5
AI_APPROVAL_AUDIO_TRANSCRIPTION_ENABLED=false

# Секунды ожидания одного ответа generate_content (защита от зависаний SDK; по умолчанию 180)
# GEMINI_GENERATE_TIMEOUT_SEC=180

# ElevenLabs (опционально)
ELEVENLABS_API_KEY="PASTE_ELEVENLABS_API_KEY"
ELEVENLABS_VOICE_ID="PASTE_ELEVENLABS_VOICE_ID"

# Vertex (вариант с API key, опционально)
VERTEX_API_KEY="PASTE_VERTEX_API_KEY"
# Image generation profile:
# cheap: gemini-2.5-flash-image -> gemini-3.1-flash-image-preview -> gemini-3-pro-image-preview
# balanced: gemini-3.1-flash-image-preview -> gemini-3-pro-image-preview -> gemini-2.5-flash-image
# best: gemini-3-pro-image-preview first
# legacy: use VERTEX_IMAGE_MODEL + VERTEX_IMAGE_MODEL_FALLBACKS exactly
IMAGE_GENERATION_PROFILE="legacy"
VERTEX_IMAGE_MODEL="gemini-3-pro-image-preview"
VERTEX_IMAGE_MODEL_FALLBACKS="gemini-3.1-flash-image-preview,gemini-2.5-flash-image"
# Requested image generation size. Values above 2K are coerced back to 2K in code.
VERTEX_IMAGE_SIZE="2K"

# Vertex (вариант с service account, опционально)
GOOGLE_APPLICATION_CREDENTIALS="/abs/path/to/service-account.json"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
# Project scope for prompt policies. Default keeps cooking-specific veo3 cast rule (grandma+cat in frame).
# CONTENT_FABRIC_PROJECT_SCOPE="grandma_kitchen"

# PostgreSQL (SQLAlchemy sync)
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/content_fabric"

# Syntax video generation via Telethon (optional; tried before Vertex when enabled)
# SYNTAX_FALLBACK_ENABLED=1
# SYNTAX_FALLBACK_MODE=manual
# SYNTAX_FALLBACK_TIMEOUT_SEC=900
# Maximum wait to enter the serialized Syntax queue. Defaults to SYNTAX_FALLBACK_TIMEOUT_SEC.
# SYNTAX_FALLBACK_LOCK_TIMEOUT_SEC=900
# SYNTAX_FALLBACK_POLL_SEC=10
# Syntax text prompt hard limit is 2000 chars; longer prompts are shortened via Gemini before send.
# SYNTAX_PROMPT_MAX_CHARS=2000
# SYNTAX_STRICT_REPLY_MATCH=1
# SYNTAX_BOT_USERNAME="@syntxaibot"
# TELEGRAM_API_ID="123456"
# TELEGRAM_API_HASH="your_api_hash"
# TELETHON_SESSION_PATH="/abs/path/to/telethon.session"
# Or multiple sessions for parallel Syntax-first generation:
# TELETHON_SESSION_PATHS="/abs/path/to/one.session,/abs/path/to/two.session"
# or:
# TELETHON_STRING_SESSION="your_string_session"
# Or multiple string sessions:
# TELETHON_STRING_SESSIONS="string_session_one,string_session_two"
# Minimum width/height for frames sent to Syntax (default 300)
# SYNTAX_MIN_IMAGE_EDGE_PX=300

# Maximum wait for one Vertex Veo long-running operation (default 900, range 60..3600).
# VERTEX_VIDEO_OPERATION_TIMEOUT_SEC=900

# Autoposting / n8n bridge (future use)
# Recommended split:
# - keep platform OAuth secrets in n8n credentials
# - keep only shared integration settings here when Python must call n8n or accept callbacks
# N8N_PUBLISH_WEBHOOK_URL="https://n8n.example/webhook/content-fabric-publish"
# N8N_PUBLISH_WEBHOOK_TOKEN="PASTE_N8N_SHARED_SECRET"
# CONTENT_FABRIC_PUBLIC_BASE_URL="https://content-fabric.example"
# PUBLICATION_ARTIFACTS_DIR="/opt/content_fabric/artifacts/publications"

# YouTube publish credentials (official API)
# YOUTUBE_CLIENT_ID="PASTE_GOOGLE_OAUTH_CLIENT_ID"
# YOUTUBE_CLIENT_SECRET="PASTE_GOOGLE_OAUTH_CLIENT_SECRET"
# YOUTUBE_REFRESH_TOKEN="PASTE_YOUTUBE_REFRESH_TOKEN"
# YOUTUBE_CHANNEL_ID_RU="PASTE_RU_CHANNEL_ID"
# YOUTUBE_CHANNEL_ID_EN="PASTE_EN_CHANNEL_ID"

# Instagram publish credentials (official Graph API for professional accounts)
# INSTAGRAM_APP_ID="PASTE_META_APP_ID"
# INSTAGRAM_APP_SECRET="PASTE_META_APP_SECRET"
# INSTAGRAM_ACCESS_TOKEN="PASTE_INSTAGRAM_LONG_LIVED_TOKEN"
# INSTAGRAM_BUSINESS_ACCOUNT_ID_RU="PASTE_RU_IG_ACCOUNT_ID"
# INSTAGRAM_BUSINESS_ACCOUNT_ID_EN="PASTE_EN_IG_ACCOUNT_ID"
# INSTAGRAM_PAGE_ID_RU="PASTE_RU_FACEBOOK_PAGE_ID"
# INSTAGRAM_PAGE_ID_EN="PASTE_EN_FACEBOOK_PAGE_ID"

# TikTok publish credentials (official Content Posting API)
# TIKTOK_CLIENT_KEY="PASTE_TIKTOK_CLIENT_KEY"
# TIKTOK_CLIENT_SECRET="PASTE_TIKTOK_CLIENT_SECRET"
# TIKTOK_ACCESS_TOKEN="PASTE_TIKTOK_ACCESS_TOKEN"
# TIKTOK_OPEN_ID="PASTE_TIKTOK_OPEN_ID"

# VK publish credentials (official VK API)
# VK_CLIENT_ID="PASTE_VK_APP_ID"
# VK_CLIENT_SECRET="PASTE_VK_CLIENT_SECRET"
# VK_ACCESS_TOKEN="PASTE_VK_ACCESS_TOKEN"
# VK_GROUP_ID_RU="PASTE_RU_VK_GROUP_ID"

# RuTube: keep account login data and any future API token in n8n credentials or a secret manager.
# The repo currently uses generated title/description only; upload integration should be enabled only after
# confirming a stable official upload path for your account type.
# RUTUBE_CHANNEL_ID_RU="PASTE_RUTUBE_CHANNEL_ID"
