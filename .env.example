TELEGRAM_BOT_TOKEN="PASTE_TELEGRAM_BOT_TOKEN"

# Gemini model selection (transport: Vertex AI)
GEMINI_MODEL=gemini-2.5-flash

# AI approval QA mode (optional)
AI_APPROVAL_ENABLED=true
AI_APPROVAL_MODEL=gemini-2.5-flash-lite
AI_APPROVAL_STRICTNESS=balanced
AI_APPROVAL_MAX_REGENERATE_ATTEMPTS=2
AI_APPROVAL_IMAGE_THRESHOLD=0.85
AI_APPROVAL_VIDEO_THRESHOLD=0.85
AI_APPROVAL_HUMAN_REVIEW_THRESHOLD=0.70
AI_APPROVAL_EXTRACT_VIDEO_FRAMES=true
AI_APPROVAL_FRAME_COUNT=5
AI_APPROVAL_AUDIO_TRANSCRIPTION_ENABLED=false

# Секунды ожидания одного ответа generate_content (защита от зависаний SDK; по умолчанию 180)
# GEMINI_GENERATE_TIMEOUT_SEC=180
# Отдельный увеличенный дедлайн для медленной генерации изображений Vertex (секунды).
# VERTEX_IMAGE_GENERATE_TIMEOUT_SEC=480

# ElevenLabs (опционально)
ELEVENLABS_API_KEY="PASTE_ELEVENLABS_API_KEY"
ELEVENLABS_VOICE_ID="PASTE_ELEVENLABS_VOICE_ID"

# Vertex (вариант с API key, опционально)
VERTEX_API_KEY="PASTE_VERTEX_API_KEY"
# Image generation starts on the strongest model. Fallbacks are offered only after
# a generation failure and require explicit user approval.
VERTEX_IMAGE_MODEL="gemini-3-pro-image"
VERTEX_IMAGE_MODEL_FALLBACKS="gemini-3.1-flash-image,gemini-2.5-flash-image"
# Requested image generation size. Values above 2K are coerced back to 2K in code.
VERTEX_IMAGE_SIZE="2K"

# Vertex (вариант с service account, опционально)
GOOGLE_APPLICATION_CREDENTIALS="/abs/path/to/service-account.json"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
# Project scope for prompt policies. Default keeps cooking-specific veo3 cast rule (grandma+cat in frame).
# CONTENT_FABRIC_PROJECT_SCOPE="grandma_kitchen"

# PostgreSQL (SQLAlchemy sync)
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/content_fabric"

# Django admin public access (optional)
# Keep DJANGO_DEBUG=1 for local-only use. For internet-facing access, use HTTPS,
# a strong DJANGO_SECRET_KEY, a non-default DJANGO_ADMIN_PATH, and a real domain.
# DJANGO_PUBLIC_ADMIN=1
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY="PASTE_LONG_RANDOM_SECRET"
# DJANGO_ALLOWED_HOSTS="admin.example.com"
# DJANGO_CSRF_TRUSTED_ORIGINS="https://admin.example.com"
# CONTENT_FABRIC_PUBLIC_BASE_URL="https://admin.example.com"
# DJANGO_ADMIN_PATH="private-admin-path"
# DJANGO_STATIC_ROOT="/opt/content_fabric/runtime/django_static"
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Enable only when the whole domain and all subdomains are HTTPS-only.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_SECURE_HSTS_PRELOAD=1

# Syntax video generation via Telethon (optional; tried before Vertex when enabled)
# SYNTAX_FALLBACK_ENABLED=1
# SYNTAX_FALLBACK_MODE=manual
# SYNTAX_FALLBACK_TIMEOUT_SEC=900
# Maximum wait to enter the serialized Syntax queue. Defaults to SYNTAX_FALLBACK_TIMEOUT_SEC.
# SYNTAX_FALLBACK_LOCK_TIMEOUT_SEC=900
# SYNTAX_FALLBACK_POLL_SEC=10
# Syntax text prompt hard limit is 2000 chars; longer prompts are shortened via Gemini before send.
# SYNTAX_PROMPT_MAX_CHARS=2000
# SYNTAX_STRICT_REPLY_MATCH=1
# SYNTAX_BOT_USERNAME="@syntxaibot"
# TELEGRAM_API_ID="123456"
# TELEGRAM_API_HASH="your_api_hash"
# TELETHON_SESSION_PATH="/abs/path/to/telethon.session"
# Or multiple sessions for parallel Syntax-first generation:
# TELETHON_SESSION_PATHS="/abs/path/to/one.session,/abs/path/to/two.session"
# or:
# TELETHON_STRING_SESSION="your_string_session"
# Or multiple string sessions:
# TELETHON_STRING_SESSIONS="string_session_one,string_session_two"
# Minimum width/height for frames sent to Syntax (default 300)
# SYNTAX_MIN_IMAGE_EDGE_PX=300
# Kling Syntax webapp mode additionally needs the Playwright browser runtime:
# .venv/bin/python -m playwright install chromium

# Maximum wait for one Vertex Veo long-running operation (default 900, range 60..3600).
# VERTEX_VIDEO_OPERATION_TIMEOUT_SEC=900

# Direct social publishing. Secrets are isolated per project using
# PUBLISH_<PROJECT_SLUG>_<KEY>. Never reuse Grandma Kitchen tokens for Discipline.
# CONTENT_FABRIC_PUBLIC_BASE_URL="https://content-fabric.example"
# PUBLICATION_ARTIFACTS_DIR="/opt/content_fabric/artifacts/publications"
# PUBLICATION_MEDIA_SIGNING_KEY="PASTE_LONG_RANDOM_SECRET"
# PUBLICATION_WORKER_BATCH_SIZE=20
# YOUTUBE_PRIVACY_STATUS="private"
# TIKTOK_PRIVACY_LEVEL="SELF_ONLY"
# TIKTOK_IS_AIGC=1
#
# Grandma Kitchen examples:
# PUBLISH_GRANDMA_KITCHEN_YOUTUBE_CLIENT_ID="..."
# PUBLISH_GRANDMA_KITCHEN_YOUTUBE_CLIENT_SECRET="..."
# PUBLISH_GRANDMA_KITCHEN_YOUTUBE_REFRESH_TOKEN="..."
# PUBLISH_GRANDMA_KITCHEN_YOUTUBE_CHANNEL_ID_RU="..."
# PUBLISH_GRANDMA_KITCHEN_INSTAGRAM_ACCESS_TOKEN="..."
# PUBLISH_GRANDMA_KITCHEN_INSTAGRAM_BUSINESS_ACCOUNT_ID_RU="..."
# PUBLISH_GRANDMA_KITCHEN_TIKTOK_ACCESS_TOKEN="..."
# PUBLISH_GRANDMA_KITCHEN_TIKTOK_OPEN_ID="..."
# PUBLISH_GRANDMA_KITCHEN_VK_ACCESS_TOKEN="..."
# PUBLISH_GRANDMA_KITCHEN_VK_GROUP_ID_RU="..."
#
# Discipline examples use the same suffixes:
# PUBLISH_DISCIPLINE_YOUTUBE_CLIENT_ID="..."
# PUBLISH_DISCIPLINE_YOUTUBE_CLIENT_SECRET="..."
# PUBLISH_DISCIPLINE_YOUTUBE_REFRESH_TOKEN="..."
# PUBLISH_DISCIPLINE_YOUTUBE_CHANNEL_ID_RU="..."
# PUBLISH_DISCIPLINE_INSTAGRAM_ACCESS_TOKEN="..."
# PUBLISH_DISCIPLINE_INSTAGRAM_BUSINESS_ACCOUNT_ID_RU="..."
# PUBLISH_DISCIPLINE_TIKTOK_ACCESS_TOKEN="..."
# PUBLISH_DISCIPLINE_TIKTOK_OPEN_ID="..."
# PUBLISH_DISCIPLINE_VK_ACCESS_TOKEN="..."
# PUBLISH_DISCIPLINE_VK_GROUP_ID_RU="..."

# Optional: upload final render artifacts to Yandex Disk after local saving.
# Uploads are enabled automatically when a token is set, unless YANDEX_DISK_UPLOAD_ENABLED=0.
# YANDEX_DISK_OAUTH_TOKEN="PASTE_YANDEX_DISK_OAUTH_TOKEN"
# YANDEX_DISK_UPLOAD_ENABLED=1
# YANDEX_DISK_BASE_PATH="/Content Fabric/final builds"
# YANDEX_DISK_OVERWRITE=1
# YANDEX_DISK_PUBLISH=0
# YANDEX_DISK_REQUIRED=0
# YANDEX_DISK_TIMEOUT_SEC=120
